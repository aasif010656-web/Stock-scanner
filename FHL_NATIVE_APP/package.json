{
  "name": "fhl-electronics-stock-scanner",
  "version": "6.1.0",
  "description": "FHL ELECTRONICS - Stock Scanner & Inventory Management App",
  "private": true,
  "scripts": {
    "start": "cap serve",
    "build": "cap sync android",
    "android": "cap open android",
    "build:android": "cd android && ./gradlew assembleRelease",
    "sync:web": "node scripts/sync-web-assets.mjs",
    "sync:ios": "pnpm run sync:web && cap sync ios",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/barcode-scanner": "5.0.0-beta.1",
    "@capacitor/android": "^5.5.0",
    "@capacitor/camera": "^5.0.8",
    "@capacitor/core": "^5.5.0",
    "@capacitor/filesystem": "^5.2.2",
    "@capacitor/ios": "^5.7.8",
    "@capacitor/local-notifications": "^5.0.8",
    "@capacitor/share": "^5.0.8",
    "firebase": "^10.12.2",
    "jsbarcode": "^3.11.5",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.5.0"
  },
  "capacitor": {
    "appId": "com.abdulasif.pdtstockscanner",
    "appName": "FHL ELECTRONICS v6",
    "webDir": "www"
  }
}
